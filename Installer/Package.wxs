  <Package UpgradeCode="A5E5B16A-9E41-4D56-8C79-70D2447A4C36" Compressed="yes" Id="SaarOSS.DiscForgeStudio" Manufacturer="Michael Nicola" Version="1.5.17.8" InstallerVersion="500" Name="DiscForge Studio 1.5.0-alpha.2-dev.18" Language="1031" Scope="perMachine">
