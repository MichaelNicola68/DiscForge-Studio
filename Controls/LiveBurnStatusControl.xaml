<UserControl x:Class="DiscForgeStudio.Controls.LiveBurnStatusControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="142">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="LiveTrackBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF20D6E8" Offset="0"/>
            <GradientStop Color="#FF4DE7F3" Offset="0.48"/>
            <GradientStop Color="#FF7868F7" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="LiveProgressStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="#1A2A40"/>
            <Setter Property="Foreground" Value="{StaticResource LiveTrackBrush}"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                            <Grid x:Name="PART_Track" ClipToBounds="True">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="8" Background="{TemplateBinding Foreground}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#5539D6E8" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                                    </Border.Effect>
                                    <Border x:Name="Shimmer" Width="110" HorizontalAlignment="Right" Opacity="0.38">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                <GradientStop Color="#BFFFFFFF" Offset="0.5"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.RenderTransform>
                                            <TranslateTransform X="-110"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="False">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Shimmer"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             From="-110" To="150" Duration="0:0:1.55"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#0B1728" BorderBrush="#29445F" BorderThickness="1" CornerRadius="14" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#39D6E8" VerticalAlignment="Center">
                    <Ellipse.Effect>
                        <DropShadowEffect x:Name="StatusGlow" Color="#39D6E8" BlurRadius="10" ShadowDepth="0" Opacity="0.95"/>
                    </Ellipse.Effect>
                </Ellipse>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="LIVE-BRENNSTATUS" FontSize="10" FontWeight="Bold" Foreground="#7693AD"/>
                    <TextBlock x:Name="PhaseTextBlock" Text="Bereit" FontSize="17" FontWeight="SemiBold" Foreground="#F2F7FF" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock x:Name="PercentTextBlock" Grid.Column="3" Text="0 %" FontSize="30" FontWeight="Bold" Foreground="#4DE7F3" VerticalAlignment="Center"/>
            </Grid>

            <ProgressBar x:Name="LiveProgressBar" Grid.Row="2" Minimum="0" Maximum="100" Value="0" Style="{StaticResource LiveProgressStyle}"/>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="DetailTextBlock" Text="Noch kein Schreibvorgang gestartet." Foreground="#9DB0C5" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ItemTextBlock" Text="" Foreground="#5EDDEA" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" HorizontalAlignment="Right">
                    <TextBlock Text="VERSTRICHEN" Foreground="#607B96" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="ElapsedTextBlock" Text="00:00" Foreground="#DCEBFA" FontFamily="Consolas" FontSize="13" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
